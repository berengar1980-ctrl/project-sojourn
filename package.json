{
  "name": "project-sojourn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-tests.cjs",
    "test:quick": "node tests/run-tests.cjs",
    "test:full": "node tests/run-tests.cjs full",
    "test:economy-horizons": "node scripts/audit-economy-horizons.cjs",
    "combat:simulate": "node scripts/simulate-combat.cjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:report": "node scripts/dependency-report.cjs --write",
    "deps:check": "node scripts/dependency-report.cjs --check",
    "check": "npm run check:quick && npm run build",
    "test:ships": "node tests/assets/ship-asset-standard.test.cjs",
    "check:quick": "npm run format:check && npm run lint && npm run typecheck && npm run deps:check && npm run persistence:check && npm run test:quick",
    "check:full": "npm run format:check && npm run lint && npm run typecheck && npm run deps:check && npm run persistence:check && npm run test:full && npm run build",
    "hardpoints:edit": "vite --open /tools/hardpoint-editor.html",
    "parity:check": "node scripts/check-feature-parity.cjs",
    "audio:import-originals": "node scripts/import-original-audio.cjs",
    "persistence:check": "node scripts/check-career-persistence.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.7"
  }
}
