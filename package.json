{
  "name": "project-sojourn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SOJOURN top-down space game",
  "scripts": {
    "test": "node tests/run-tests.cjs",
    "test:quick": "node tests/run-tests.cjs",
    "test:full": "node tests/run-tests.cjs full",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:report": "node scripts/dependency-report.cjs --write",
    "deps:check": "node scripts/dependency-report.cjs --check",
    "check": "npm run format:check && npm run lint && npm run deps:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "acorn": "^8.18.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
